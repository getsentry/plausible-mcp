{
  "name": "plausible-mcp",
  "version": "0.11.2",
  "description": "MCP server for Plausible Analytics — query traffic, conversions, and compare periods from any AI tool",
  "type": "module",
  "bin": {
    "plausible-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.worker.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "inspect": "pnpm build && npx @modelcontextprotocol/inspector --config mcp.json --server plausible-mcp",
    "inspect:cli": "pnpm build && npx @modelcontextprotocol/inspector --cli --config mcp.json --server plausible-mcp --method tools/list",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eval": "tsx evals/run.ts",
    "deploy:worker": "bash bin/deploy-worker.sh"
  },
  "keywords": [
    "mcp",
    "plausible",
    "analytics",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@sentry/cloudflare": "11.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "openai": "^7.45.1",
    "sentry": "^0.47.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
