{
  // Type-checks the tests, which tsconfig.json and tsconfig.worker.json exclude. The tests
  // import both entry points' code, so they get Node and Workers types; no emit.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node", "vitest/globals", "@cloudflare/workers-types"]
  },
  "include": ["src", "__tests__"],
  "exclude": ["node_modules", "dist"]
}
