{
  // Type-checks the tests, which ../tsconfig.json and ../tsconfig.worker.json exclude. The
  // tests import both entry points' code, so they get Node and Workers types; no emit. It
  // lives here so type-aware lint, which uses each file's nearest tsconfig.json, sees the
  // same types.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "types": ["node", "vitest/globals", "@cloudflare/workers-types"]
  },
  "include": ["**/*", "../src"],
  "exclude": []
}
