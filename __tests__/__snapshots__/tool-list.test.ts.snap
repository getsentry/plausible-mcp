      "description": "Send feedback about this server to its maintainers, not to Plausible. Use it at most once per task, after you finish or give up, when a tool was missing, broken, or confusing.",
      "execution": undefined,
      "icons": undefined,
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
