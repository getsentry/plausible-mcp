                  "type": "array",
                },
              },
              "required": [
                "dimensions",
                "metrics",
              ],
              "type": "object",
            },
            "type": "array",
          },
        },
        "required": [
          "metrics",
          "dimensions",
          "results",
        ],
        "type": "object",
      },
      "title": "Get Timeseries",
    },
    {
