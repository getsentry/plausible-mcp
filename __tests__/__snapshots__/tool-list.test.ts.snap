                          },
                          "value": {
                            "type": "number",
                          },
                        },
                        "required": [
                          "value",
                          "currency",
                          "short",
                          "long",
                        ],
                        "type": "object",
                      },
                    ],
                  },
                  "type": "array",
                },
              },
              "required": [
                "dimensions",
                "metrics",
              ],
              "type": "object",
            },
            "type": "array",
          },
        },
        "required": [
          "metrics",
          "dimensions",
          "results",
        ],
        "type": "object",
      },
      "title": "Get Timeseries",
    },
