      "description": "Find which pages gained or lost pageviews, or which sources or channels gained or lost visits between two periods. Ranks changes across all groups, including groups that appeared or disappeared. Set direction to losses for a drop.",
      "execution": undefined,
      "icons": undefined,
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
